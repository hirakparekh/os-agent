# Ops-console backend image. Build context = repo root (needs security/ + console/).
#   docker build -f console/deploy/Dockerfile.backend -t ops-console-backend .
FROM python:3.11-slim

RUN pip install --no-cache-dir uv
WORKDIR /app
ENV PYTHONPATH=/app

# Deps first (cache layer)
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev

# Source: the console backend + the shared JWT module it imports (security/tokens.py)
COPY security ./security
COPY console/__init__.py ./console/__init__.py
COPY console/backend ./console/backend

EXPOSE 8000
CMD ["uv", "run", "--no-dev", "uvicorn", "console.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
